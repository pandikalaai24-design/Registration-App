import { useState } from "react";

export default function App() {
  const [form, setForm] = useState({ name: "", email: "", workshop: "" });
  const [participants, setParticipants] = useState([]);
  const [confirmation, setConfirmation] = useState(null);
  const [error, setError] = useState("");

  const handleChange = (e) => {
    setForm({ ...form, [e.target.name]: e.target.value });
    setError("");
  };

  const handleSubmit = () => {
    if (!form.name || !form.email || !form.workshop) {
      setError("Please fill in all fields.");
      return;
    }

    const isDuplicate = participants.some(
      (p) => p.email === form.email && p.workshop === form.workshop
    );
    if (isDuplicate) {
      setError("You already registered for this workshop!");
      return;
    }

    const newEntry = {
      id: Date.now(),
      name: form.name,
      email: form.email,
      workshop: form.workshop,
    };

    setParticipants([...participants, newEntry]);
    setConfirmation(newEntry);
    setForm({ name: "", email: "", workshop: "" });
    setError("");
  };

  return (
    <div style={{ maxWidth: 600, margin: "40px auto", fontFamily: "sans-serif", padding: "0 16px" }}>
      <h1 style={{ color: "#4f46e5" }}>Workshop Registration</h1>

      {/* FORM */}
      <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
        <input
          name="name"
          value={form.name}
          onChange={handleChange}
          placeholder="Full Name"
          style={inputStyle}
        />
        <input
          name="email"
          value={form.email}
          onChange={handleChange}
          placeholder="Email Address"
          style={inputStyle}
        />
        <select
          name="workshop"
          value={form.workshop}
          onChange={handleChange}
          style={inputStyle}
        >
          <option value="">-- Select Workshop --</option>
          <option value="React Basics">React Basics</option>
          <option value="Python & CV">Python & CV</option>
          <option value="UI/UX Design">UI/UX Design</option>
        </select>

        {error && <p style={{ color: "red", margin: 0 }}>{error}</p>}

        <button onClick={handleSubmit} style={btnStyle}>
          Register
        </button>
      </div>

      {/* CONFIRMATION */}
      {confirmation && (
        <div style={{ marginTop: 24, padding: 16, background: "#dcfce7", borderRadius: 8 }}>
          <h3 style={{ margin: "0 0 10px" }}>✅ Registration Confirmed!</h3>
          <p style={pStyle}><strong>Name:</strong> {confirmation.name}</p>
          <p style={pStyle}><strong>Email:</strong> {confirmation.email}</p>
          <p style={pStyle}><strong>Workshop:</strong> {confirmation.workshop}</p>
        </div>
      )}

      {/* PARTICIPANT LIST */}
      {participants.length > 0 && (
        <div style={{ marginTop: 32 }}>
          <h2 style={{ color: "#1e1b4b" }}>
            Registered Participants ({participants.length})
          </h2>
          {participants.map((p) => (
            <div key={p.id} style={cardStyle}>
              <strong>{p.name}</strong>
              <span style={{ color: "#6b7280" }}> — {p.email}</span>
              <span style={{ float: "right", background: "#e0e7ff", padding: "2px 10px", borderRadius: 20, fontSize: 12 }}>
                {p.workshop}
              </span>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

const inputStyle = {
  padding: "10px 14px",
  fontSize: 15,
  borderRadius: 8,
  border: "1.5px solid #d1d5db",
  outline: "none",
};

const btnStyle = {
  padding: "12px",
  background: "#4f46e5",
  color: "#fff",
  border: "none",
  borderRadius: 8,
  fontSize: 15,
  fontWeight: 700,
  cursor: "pointer",
};

const cardStyle = {
  padding: "12px 16px",
  marginBottom: 8,
  background: "#f3f4f6",
  borderRadius: 8,
  fontSize: 14,
};

const pStyle = {
  margin: "4px 0",
  fontSize: 14,
};